<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saeko_credentials_import_form" model="ir.ui.view">
        <field name="name">saeko.credentials.import.form</field>
        <field name="model">saeko.credentials.import</field>
        <field name="arch" type="xml">
            <form string="Importar Service Account">
                <div class="alert alert-warning" role="alert">
                    Pegue el bloque <code>service_account</code> que entrega soporte SAEKO.
                    La llave privada queda en la base de datos, visible solo para el grupo
                    Administración/Ajustes, y nunca se escribe en la bitácora.
                </div>
                <group>
                    <field name="backend_id" readonly="1"/>
                    <field name="user_email" placeholder="usuario.api@universidad.edu.mx"/>
                </group>
                <field name="content" widget="ace" options="{'mode': 'yaml'}"
                       placeholder="service_account:&#10;  auth_url: &quot;https://...&quot;&#10;  api_url: &quot;https://...&quot;&#10;  client_id: &quot;...&quot;&#10;  private_key_id: &quot;...&quot;&#10;  private_key: &quot;-----BEGIN RSA PRIVATE KEY-----\n...&quot;&#10;  expires_at: &quot;2027-01-01T00:00:00Z&quot;"/>
                <footer>
                    <button name="action_import" type="object" string="Importar"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
